{
  "name": "@guessir/backend",
  "version": "1.0.14",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -b tsconfig.build.json",
    "clean": "del-cli ./dist ./tsconfig.build.tsbuildinfo",
    "start": "node ./dist/entrypoints/server/start.js",
    "db:migrate": "node --env-file=env/.env.development ./dist/entrypoints/migrate/start.js",
    "dev:compile": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "dev:run": "node --watch --env-file=env/.env.development ./dist/entrypoints/server/start.js",
    "dev:watch": "run-p dev:compile dev:run",
    "dev:run:debug": "node --env-file=env/.env.development --inspect-brk ./dist/entrypoints/server/start.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@guessir/game": "^1.0.0",
    "@guessir/logger": "^1.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1"
  }
}
