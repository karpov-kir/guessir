{
  "name": "@guessir/backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -b tsconfig.build.json",
    "clean": "del-cli ./dist ./tsconfig.build.tsbuildinfo",
    "start": "node ./dist/entrypoints/server/start.js",
    "start:dev": "docker compose up -d --wait && npm run build && run-p dev:compile dev:run",
    "start:dev:debug": "docker compose up -d --wait && npm run build && node --env-file=env/.env.development --inspect-brk ./dist/entrypoints/server/start.js",
    "build:docker": "docker build --platform=linux/amd64 -t guessir-backend -f ./Dockerfile ../..",
    "dev:compile": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "dev:run": "node --watch --env-file=env/.env.development ./dist/entrypoints/server/start.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@guessir/game": "^1.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1"
  }
}
