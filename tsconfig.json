{
  // Covers only the files at the root: a package checks its own files, and a program built from
  // this config never reads a package build output that a parallel build is rewriting
  "extends": "./tsconfig.base.json",
  // The vitest configs import their shared projects with the .ts extension, which Vite's native
  // config loader needs
  "compilerOptions": { "allowImportingTsExtensions": true },
  "include": ["*.ts"]
}
