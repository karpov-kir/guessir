{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    // thread-stream, which fastify 5 pulls in through pino, does not type-check against @types/node 26
    "skipLibCheck": true
  },
  "references": [
    {
      "path": "../shared/tsconfig.build.json"
    }
  ],
}
