{
  "name": "@guessir/game",
  "type": "module",
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "source": "./src/shared/exports.ts",
      "types": "./dist/shared/exports.d.ts",
      "default": "./dist/shared/exports.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc -b tsconfig.build.json",
    "clean": "del-cli ./dist ./tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
