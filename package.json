{
  "name": "@guessir/monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:format": "oxfmt --check",
    "lint:format:fix": "oxfmt",
    "lint:tsc": "tsc -p apps/backend/tsconfig.json && tsc -p packages/game/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint:stylelint": "stylelint \"{apps,packages}/*/src/**/*.css\"",
    "lint:stylelint:fix": "npm run lint:stylelint -- --fix",
    "lint": "run-p -c lint:*[!fix]",
    "lint:fix": "run-s -c lint:oxlint:fix lint:stylelint:fix lint:format:fix",
    "start:dev:backend": "npm run start:dev -w @guessir/backend",
    "start:dev:web": "npm run start:dev -w @guessir/web",
    "start:backend": "npm run start -w @guessir/backend",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:watch": "vitest watch",
    "build:docker": "npm run build:docker --workspaces --if-present"
  },
  "devDependencies": {
    "@kk-forge/oxlint-config": "^5.0.1",
    "@kk-forge/stylelint-config": "^1.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "del-cli": "^8.0.1",
    "jsdom": "^30.1.3",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "stylelint": "^18.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "allowScripts": {
    "cpu-features": false,
    "fsevents": false,
    "protobufjs": false,
    "ssh2": false
  }
}
