{
  "name": "@guessir/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @guessir/web",
    "clean": "npm run clean --workspaces --if-present",
    "lint:eslint": "eslint \"packages/**/src/**/*.ts\" \"packages/**/tests/**/*.ts\" \"packages/**/loaders/**/*.{ts,mjs}\"",
    "lint:eslint:fix": "npm run lint:eslint -- --fix",
    "lint:tsc": "tsc --noEmit -p packages/backend/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "lint:stylelint": "stylelint \"packages/**/src/**/*.{css,scss}\"",
    "lint:stylelint:fix": "npm run lint:stylelint -- --fix",
    "lint": "run-p -c lint:*[!fix]",
    "lint:fix": "run-p -c lint:*:fix",
    "start:dev:backend": "npm run start:dev -w @guessir/backend",
    "start:dev:web": "npm run start:dev -w @guessir/web",
    "start:backend": "npm run start -w @guessir/backend",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:watch": "vitest watch",
    "build:docker": "npm run build:docker --workspaces --if-present",
    "publish:docker": "npm run publish:docker --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "del-cli": "^8.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.1.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1",
    "vitest-sonar-reporter": "^3.0.0"
  }
}
