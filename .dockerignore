# Both images build from the repository root, so this file covers them. Docker does not read a
# .dockerignore beside a Dockerfile
**/node_modules
**/dist
**/*.tsbuildinfo
coverage
.git
# Of the backend's env files only production's, which holds no secret, enters a build. Production reads
# its database password from a Docker secret
apps/backend/env/*
!apps/backend/env/.env.production
